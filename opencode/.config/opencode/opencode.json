{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "external_directory": {
      "*": "ask",
      "~/Documents/bruno/**": "allow"
    },
    "bash": {
      "*": "allow",
      "pnpm lint": "allow",
      "pnpm test*": "allow",
      "npm lint": "allow",
      "npm test*": "allow",
      "rm *": "deny",
      "npm *": "deny",
      "pnpm *": "deny",
      "yarn *": "deny",
      "pip *": "deny",
      "aws *": "deny",
      "sudo *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git clean *": "deny",
      "git checkout *": "deny"
    }
  }
}
